# --- DB (ローカルは docker compose up -d db) ---
DATABASE_URL=postgresql://commitpay:commitpay@localhost:55432/commitpay_agi_lab

# --- Gemini ---
# 最速: Gemini API キー方式 (GCPプロジェクト設定不要)
GOOGLE_API_KEY=
# Vertex AI 方式に切り替える場合は USE_VERTEX=1 + gcloud auth application-default login
USE_VERTEX=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
JUDGE_MODEL=gemini-2.5-flash
ARBITER_MODEL=gemini-2.5-pro
DESIGNER_MODEL=gemini-2.5-flash

# --- Storage ---
# local = ./.data/uploads に保存 (GCP不要) / gcs = Cloud Storage 署名付きURL
STORAGE_DRIVER=local
GCS_BUCKET=

# --- Stripe (テストモード) ---
# 未設定なら決済は MOCK 実行される (ハッカソンデモ用)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Worker ---
# Cloud Scheduler から叩く /api/cron/tick の共有シークレット
CRON_SECRET=dev-secret
# 猶予期間(時間)。デモでは 0.01 (=36秒) などに縮められる
GRACE_PERIOD_HOURS=24

# --- マイページ / カード登録 (Stripe Elements) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY はブラウザ側の Stripe Elements で使う公開キー (pk_test_...)。
# STRIPE_SECRET_KEY と両方が設定されているときだけ /mypage にカード登録UIが出る。
# 未設定ならカードUIは出さず「テストモード（ペナルティは MOCKED 記録）」と表示される。
# テストカードは 4242 4242 4242 4242 （Stripe テストモード専用）。
